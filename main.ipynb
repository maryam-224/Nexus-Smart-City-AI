# --- MODULE: PROPOSITIONAL LOGIC INFERENCE CONSOLE (EXACTLY PRESERVED) ---
class PropositionalLogicEngine:
    @staticmethod
    def evaluate_op(op, var1, var2=None):
        if op == "NOT": return not var1
        if op == "AND": return var1 and var2
        if op == "OR": return var1 or var2
        if op == "XOR": return var1 != var2
        if op == "NAND": return not (var1 and var2)
        if op == "NOR": return not (var1 or var2)
        if op == "IMPLICATION": return (not var1) or var2
        if op == "BICONDITIONAL": return var1 == var2
        return False
    @staticmethod
    def generate_truth_table(op):
        print(f"\n📊 TRUTH TABLE FOR CORE EXPERT OPERATION: {op}")
        print("+" + "-"*7 + "+" + "-"*7 + "+" + "-"*15 + "+")
        print(f"|   P   |   Q   |    RESULT     |")
        print("+" + "-"*7 + "+" + "-"*7 + "+" + "-"*15 + "+")
        for P in [True, False]:
            for Q in [True, False]:
                res = PropositionalLogicEngine.evaluate_op(op, P, Q)
                print(f"| {str(P):<5} | {str(Q):<5} | {str(res):<13} |")
        print("+" + "-"*7 + "+" + "-"*7 + "+" + "-"*15 + "+")

# --- MODULE: PRODUCTION GENETIC ROUTING SUITE (TSP) ---
class CityGeneticRouter:
    def __init__(self, locations, coords_dict):
        self.locations = locations
        self.coords = coords_dict
    def get_distance(self, loc1, loc2):
        x1, y1 = self.coords[loc1]
        x2, y2 = self.coords[loc2]
        return math.sqrt((x1-x2)**2 + (y1-y2)**2)
    def route_fitness(self, route):
        dist = 0
        for i in range(len(route) - 1):
            dist += self.get_distance(route[i], route[i+1])
        dist += self.get_distance(route[-1], route[0])
        return 1 / (dist + 1e-6)
    def run_genetic_algorithm(self, pop_size=30, generations=40, mutation_rate=0.15):
        if len(self.locations) < 3: return self.locations, 0, [0]
        population = []
        history_fitness = []
        for _ in range(pop_size):
            ind = list(self.locations)
            random.shuffle(ind)
            population.append(ind)
        best_route = None
        best_score = -1
        for gen in range(generations):
            population = sorted(population, key=lambda r: self.route_fitness(r), reverse=True)
            current_best = population[0]
            current_fit = self.route_fitness(current_best)
            if current_fit > best_score:
                best_score = current_fit
                best_route = current_best
            history_fitness.append(1 / (current_fit + 1e-6))
            new_pop = [population[0], population[1]]
            while len(new_pop) < pop_size:
                parent1 = random.choice(population[:10])
                parent2 = random.choice(population[:10])
                cut1, cut2 = sorted(random.sample(range(len(self.locations)), 2))
                child = [None] * len(self.locations)
                child[cut1:cut2] = parent1[cut1:cut2]
                p2_fill = [item for item in parent2 if item not in child]
                idx = 0
                for i in range(len(child)):
                    if child[i] is None:
                        child[i] = p2_fill[idx]
                        idx += 1
                if random.random() < mutation_rate:
                    m1, m2 = random.sample(range(len(self.locations)), 2)
                    child[m1], child[m2] = child[m2], child[m1]
                new_pop.append(child)
            population = new_pop
        final_dist = 0
        for i in range(len(best_route)-1):
            final_dist += self.get_distance(best_route[i], best_route[i+1])
        final_dist += self.get_distance(best_route[-1], best_route[0])
        return best_route, round(final_dist, 2), history_fitness

# --- MODULE: KNOWLEDGE-BASED INVESTIGATION SYSTEMS (EXACTLY PRESERVED) ---
class WumpusSmartCityAgent:
    def __init__(self):
        self.grid_size = 4
        self.agent_pos = (0, 0)
        self.hazards = {(1, 2): "Cyber Threat Loop", (2, 3): "Severe Traffic Jam Pit"}
        self.gold_node = (2, 2)
        self.visited = set()
        self.kb_secure_nodes = set()
    def process_percepts(self):
        x, y = self.agent_pos
        percepts = []
        for h_x, h_y in self.hazards:
            if abs(x - h_x) + abs(y - h_y) == 1:
                percepts.append("⚠️ Structural Signal Fluctuations Detectable nearby!")
        if self.agent_pos == self.gold_node:
            percepts.append("✨ Target Operational Microchip Core Found!")
        return percepts
    def execute_inference_step(self):
        self.visited.add(self.agent_pos)
        percepts = self.process_percepts()
        print(f" -> Current Agent Coordinates: {self.agent_pos} | Active Live Percepts: {percepts}")
        moves = [(0,1), (1,0), (0,-1), (-1,0)]
        for dx, dy in moves:
            nx, ny = self.agent_pos[0] + dx, self.agent_pos[1] + dy
            if 0 <= nx < self.grid_size and 0 <= ny < self.grid_size:
                if (nx, ny) not in self.hazards:
                    self.kb_secure_nodes.add((nx, ny))
        for safe in self.kb_secure_nodes:
            if safe not in self.visited:
                self.agent_pos = safe
                return False
        return True

