    print(f"  🟩 Real-time Traffic Multiplier Avg : {congestion_penalty:.2f}x Factor Grid Delay")
    print(f"  🟩 Meteorological Atmosphere Status  : {WEATHER_CONDITION} (Factor Level: {WEATHER_MULTIPLIER}x)")
    print(f"  🏆 METROPOLITAN OPERATIONAL EFFICIENCY SCORE : {score}/100 Performance Points")

