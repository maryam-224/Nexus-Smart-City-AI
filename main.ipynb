class NexusComprehensiveCityAI:
    def __init__(self, graph, coords):
        self.graph = graph
        self.coords = coords

    def get_h(self, node, goal):
        x1, y1 = self.coords[node]
        x2, y2 = self.coords[goal]
        return abs(x1 - x2) + abs(y1 - y2)

    def get_dynamic_edges(self, node):
        edges = []
        for neighbor, base_w in self.graph.get(node, []):
            traffic_mod = (TRAFFIC_MULTIPLIERS[node] + TRAFFIC_MULTIPLIERS[neighbor]) / 2.0
            modified_weight = base_w * traffic_mod * WEATHER_MULTIPLIER
            edges.append((neighbor, modified_weight))
        return edges

    # --- CORE ROUTING ENGINES (EXACTLY PRESERVED) ---
    def bfs(self, start, goal):
        if start == goal: return [start]
        queue = deque([(start, [start])])
        visited = {start}
        while queue:
            node, path = queue.popleft()
            if node == goal: return path
            for neighbor, _ in self.get_dynamic_edges(node):
                if neighbor not in visited:
                    visited.add(neighbor)
                    queue.append((neighbor, path + [neighbor]))
        return []

    def dfs(self, start, goal, visited=None, path=None):
        if visited is None: visited = set()
        if path is None: path = [start]
        if start == goal: return path
        visited.add(start)
        for neighbor, _ in self.get_dynamic_edges(start):
            if neighbor not in visited:
                res = self.dfs(neighbor, goal, visited, path + [neighbor])
                if res: return res
        return []

    def dls(self, start, goal, limit, path=None):
        if path is None: path = [start]
        if start == goal: return path
        if limit <= 0: return None
        for neighbor, _ in self.get_dynamic_edges(start):
            res = self.dls(neighbor, goal, limit - 1, path + [neighbor])
            if res: return res
        return None

    def ids(self, start, goal, max_depth=15):
        for depth in range(max_depth):
            res = self.dls(start, goal, depth)
            if res: return res
        return []

    def ucs(self, start, goal):
        if start == goal: return [start], 0
        pq = [(0, start, [start])]
        visited = {}
        while pq:
            cost, node, path = heapq.heappop(pq)
            if node == goal: return path, cost
            if node not in visited or cost < visited[node]:
                visited[node] = cost
                for n, w in self.get_dynamic_edges(node):
                    heapq.heappush(pq, (cost + w, n, path + [n]))
        return [], float('inf')

    def a_star(self, start, goal):
        if start == goal: return [start], 0
        pq = [(self.get_h(start, goal), 0, start, [start])]
        visited = {}
        while pq:
            f, g, node, path = heapq.heappop(pq)
            if node == goal: return path, g
            if node not in visited or g < visited[node]:
                visited[node] = g
                for n, w in self.get_dynamic_edges(node):
                    new_g = g + w
                    heapq.heappush(pq, (new_g + self.get_h(n, goal), new_g, n, path + [n]))
        return [], float('inf')

    def greedy_best_first_search(self, start, goal):
        if start == goal: return [start], 1
        pq = [(self.get_h(start, goal), start, [start])]
        visited = {start}
        nodes_visited = 0
        while pq:
            _, node, path = heapq.heappop(pq)
            nodes_visited += 1
            if node == goal: return path, nodes_visited
            for neighbor, _ in self.get_dynamic_edges(node):
                if neighbor not in visited:
                    visited.add(neighbor)
                    heapq.heappush(pq, (self.get_h(neighbor, goal), neighbor, path + [neighbor]))
        return [], nodes_visited

    def calculate_path_cost(self, path):
        if not path or len(path) < 2: return 0
        total_cost = 0
        for i in range(len(path) - 1):
            current = path[i]
            nxt = path[i+1]
            found = False
            for neighbor, weight in self.get_dynamic_edges(current):
                if neighbor == nxt:
                    total_cost += weight
                    found = True
                    break
            if not found: return float('inf')
        return round(total_cost, 2)

    def local_quick_search(self, current_node, goal, max_iters=10):
        path = [current_node]
        current = current_node
        steps_log = []
        for i in range(max_iters):
            if current == goal: break
            neighbors = self.get_dynamic_edges(current)
            if not neighbors: break
            best_neighbor = None
            best_h = self.get_h(current, goal)
            for neighbor, _ in neighbors:
                nh = self.get_h(neighbor, goal)
                if nh < best_h:
                    best_h = nh
                    best_neighbor = neighbor
            if best_neighbor is None or best_neighbor in path:
                steps_log.append(f"Smart grid routing optimization paused at {current} (Local Maxima/Junction).")
                break
            current = best_neighbor
            path.append(current)
            steps_log.append(f"Optimizing link towards {current} (Distance Factor Left: {best_h})")
        return path, steps_log

    def wifi_firewall_protection(self, node, depth, alpha, beta, maximizing_player, log):
        if isinstance(node, (int, float)): return node
        indent = "  " * depth
        if maximizing_player:
            max_eval = -math.inf
            for child in node:
                eval_val = self.wifi_firewall_protection(child, depth + 1, alpha, beta, False, log)
                max_eval = max(max_eval, eval_val)
                alpha = max(alpha, eval_val)
                if alpha >= beta:
                    log.append(f"{indent}[FIREWALL SECURE]: Hacker loop blocked at Node Layer {depth} (Alpha={alpha} >= Beta={beta}).")
                    break
            return max_eval
        else:
            min_eval = math.inf
            for child in node:
                eval_val = self.wifi_firewall_protection(child, depth + 1, alpha, beta, True, log)
                min_eval = min(min_eval, eval_val)
                beta = min(beta, eval_val)
                if alpha >= beta:
                    log.append(f"{indent}[ATTACK ISOLATED]: Cyber threat neutralized at Threat Layer {depth} (Alpha={alpha} >= Beta={beta}).")
                    break
            return min_eval

    def expectiminimax_threat_eval(self, node, depth, is_agent_turn, log):
        indent = "  " * depth
        if isinstance(node, (int, float)): return node
        if 'type' in node and node['type'] == 'chance':
            expected_val = 0
            for outcome in node['outcomes']:
                prob = outcome['prob']
                child_node = outcome['child']
                val = self.expectiminimax_threat_eval(child_node, depth + 1, True, log)
                expected_val += prob * val
            log.append(f"{indent}[CHANCE NODE]: Calculated Expected Cost Value = {expected_val:.2f} via Probability Vector.")
            return expected_val
        if is_agent_turn:
            max_val = -math.inf
            for child in node['children']:
                val = self.expectiminimax_threat_eval(child, depth + 1, False, log)
                max_val = max(max_val, val)
            return max_val
        else:
            min_val = math.inf
            for child in node['children']:
                val = self.expectiminimax_threat_eval(child, depth + 1, True, log)
                min_val = min(min_val, val)
            return min_val

